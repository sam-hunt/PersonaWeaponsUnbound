<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Base-variant crafting recipes for the three vanilla bladelink weapon pairs
       (fork spec §10). Products are the BASE weapons — players persona-convert
       them at the customization bench afterward, completing the fiction loop
       (install a persona core, then reprogram traits). Modeled on vanilla
       Make_ComponentSpacer; effectWorking/soundWorking/workSpeedStat/workSkill
       match BaseMeleeWeapon's smithing recipeMaker convention. Per-recipe
       toggle gating lives in RecipeDef_AvailableNow_Patch.cs. -->

  <RecipeDef>
    <defName>PWU_Make_MonoSword</defName>
    <label>make monosword</label>
    <description>Craft a monosword: a crystal-metallic longsword infused with mechanites that maintain a mono-molecular cutting edge. Persona-convert it at a fabrication bench afterward to awaken its bladelink traits.</description>
    <jobString>Making monosword.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Smith</soundWorking>
    <workAmount>45000</workAmount>
    <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
    <recipeUsers>
      <li>FabricationBench</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Plasteel</li>
          </thingDefs>
        </filter>
        <count>140</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentSpacer</li>
          </thingDefs>
        </filter>
        <count>6</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Plasteel</li>
        <li>ComponentSpacer</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MeleeWeapon_MonoSword>1</MeleeWeapon_MonoSword>
    </products>
    <researchPrerequisite>PWU_BladelinkCustomization</researchPrerequisite>
    <skillRequirements>
      <Crafting>8</Crafting>
    </skillRequirements>
  </RecipeDef>

  <RecipeDef>
    <defName>PWU_Make_PlasmaSword</defName>
    <label>make plasmasword</label>
    <description>Craft a plasmasword: a metal-cored sword wrapped in a plasma sheath that slices and burns. Persona-convert it at a fabrication bench afterward to awaken its bladelink traits.</description>
    <jobString>Making plasmasword.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Smith</soundWorking>
    <workAmount>45000</workAmount>
    <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
    <recipeUsers>
      <li>FabricationBench</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Plasteel</li>
          </thingDefs>
        </filter>
        <count>120</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentSpacer</li>
          </thingDefs>
        </filter>
        <count>7</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Plasteel</li>
        <li>ComponentSpacer</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MeleeWeapon_PlasmaSword>1</MeleeWeapon_PlasmaSword>
    </products>
    <researchPrerequisite>PWU_BladelinkCustomization</researchPrerequisite>
    <skillRequirements>
      <Crafting>8</Crafting>
    </skillRequirements>
  </RecipeDef>

  <RecipeDef>
    <defName>PWU_Make_Zeushammer</defName>
    <label>make zeushammer</label>
    <description>Craft a zeushammer: a warhammer with an embedded EMP capacitor that blasts targets with an EMP burst on impact. Persona-convert it at a fabrication bench afterward to awaken its bladelink traits.</description>
    <jobString>Making zeushammer.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Smith</soundWorking>
    <workAmount>45000</workAmount>
    <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
    <recipeUsers>
      <li>FabricationBench</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Plasteel</li>
          </thingDefs>
        </filter>
        <count>70</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Uranium</li>
          </thingDefs>
        </filter>
        <count>30</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentSpacer</li>
          </thingDefs>
        </filter>
        <count>8</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Plasteel</li>
        <li>Uranium</li>
        <li>ComponentSpacer</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <MeleeWeapon_Zeushammer>1</MeleeWeapon_Zeushammer>
    </products>
    <researchPrerequisite>PWU_BladelinkCustomization</researchPrerequisite>
    <skillRequirements>
      <Crafting>8</Crafting>
    </skillRequirements>
  </RecipeDef>

</Defs>
