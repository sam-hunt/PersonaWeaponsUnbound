  <!-- Settings: Memory costs -->
  <!-- EN: Bond wipe component cost: {0} -->
  <PWU_WipeBondingComponentCost>결속 삭제 부품 비용: {0}</PWU_WipeBondingComponentCost>
  <!-- EN: Advanced components charged to wipe a persona weapon's bond, returning it to bond-on-next-equip. -->
  <PWU_WipeBondingComponentCostDesc>결속 무기의 결속을 지워 다음 장착 시 다시 결속되도록 만드는 데 소모되는 고급 부품입니다.</PWU_WipeBondingComponentCostDesc>
  <!-- EN: Kill tracker wipe component cost: {0} -->
